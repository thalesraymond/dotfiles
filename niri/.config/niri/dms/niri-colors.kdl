layout {
    background-color "transparent" 

    focus-ring {
        active-gradient from="#b2c5ff" to="#e1bbdd" angle=45
        // active-color   "#b2c5ff"
        inactive-color "#8f909a"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b2c5ff"
        inactive-color "#8f909a"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#b2c5ff"
        inactive-color "#8f909a"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b2c5ff80"
    }
}

/-recent-windows {
    highlight {
        active-color   "#304578"
        urgent-color   "#ffb4ab"
    }
}