layout {
    background-color "transparent" 

    focus-ring {
        active-gradient from="#89d0ed" to="#c4c3eb" angle=45
        // active-color   "#89d0ed"
        inactive-color "#8a9296"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#89d0ed"
        inactive-color "#8a9296"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#89d0ed"
        inactive-color "#8a9296"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#89d0ed80"
    }
}

/-recent-windows {
    highlight {
        active-color   "#004d62"
        urgent-color   "#ffb4ab"
    }
}