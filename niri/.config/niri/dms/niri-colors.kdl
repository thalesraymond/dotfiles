layout {
    background-color "transparent" 

    focus-ring {
        active-gradient from="#aac7ff" to="#ddbce0" angle=45
        // active-color   "#aac7ff"
        inactive-color "#8e9099"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#aac7ff"
        inactive-color "#8e9099"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#aac7ff"
        inactive-color "#8e9099"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#aac7ff80"
    }
}

/-recent-windows {
    highlight {
        active-color   "#284777"
        urgent-color   "#ffb4ab"
    }
}