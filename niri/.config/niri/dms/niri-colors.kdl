layout {
    background-color "transparent" 

    focus-ring {
        active-gradient from="#dfb8f6" to="#f4b7b9" angle=45
        // active-color   "#dfb8f6"
        inactive-color "#968e98"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#dfb8f6"
        inactive-color "#968e98"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#dfb8f6"
        inactive-color "#968e98"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#dfb8f680"
    }
}

/-recent-windows {
    highlight {
        active-color   "#593a6e"
        urgent-color   "#ffb4ab"
    }
}