layout {
    background-color "transparent" 

    focus-ring {
        active-gradient from="#81d3de" to="#b8c6ea" angle=45
        // active-color   "#81d3de"
        inactive-color "#899294"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#81d3de"
        inactive-color "#899294"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#81d3de"
        inactive-color "#899294"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#81d3de80"
    }
}

/-recent-windows {
    highlight {
        active-color   "#004f56"
        urgent-color   "#ffb4ab"
    }
}