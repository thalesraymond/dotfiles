layout {
    background-color "transparent" 

    focus-ring {
        active-gradient from="#8fcff3" to="#c9c1ea" angle=45
        // active-color   "#8fcff3"
        inactive-color "#8a9297"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#8fcff3"
        inactive-color "#8a9297"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#8fcff3"
        inactive-color "#8a9297"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#8fcff380"
    }
}

/-recent-windows {
    highlight {
        active-color   "#004d68"
        urgent-color   "#ffb4ab"
    }
}