workspace "games" {
    open-on-output "DP-3"
}

workspace "home" {
    open-on-output "DP-3"
}


window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}

}

window-rule {
    match is-active=true
    opacity 0.95
}

window-rule {
    match is-active=false
    opacity 0.8
}


window-rule {
    geometry-corner-radius 10
    clip-to-geometry true    
    background-effect {
        blur true
    }
    draw-border-with-background false
}

layer-rule {
    match namespace="^(dms:bar)$"

    background-effect {
        blur true
    }
}

// Thunderbird/ZapZap/PiP no HDMI-A-1 
window-rule {
    match app-id="[Ss]potify"
    open-on-output "HDMI-A-1"
    open-focused false
    open-maximized false
    open-fullscreen false
    default-column-width { proportion 0.5; }
}

window-rule {
    match app-id="com.rtosta.zapzap"
    open-on-output "HDMI-A-1"
    open-focused false
    open-maximized false
    open-fullscreen false
    open-maximized-to-edges false
    default-column-width { proportion 0.5; }
}

window-rule {
    match app-id="dev.zed.Zed"
    open-focused false
    open-maximized false
    open-fullscreen false
    open-maximized-to-edges false
    default-column-width { proportion 0.7; }
}

window-rule {
    match app-id="obsidian"
    open-focused false
    open-maximized false
    open-fullscreen false
    open-maximized-to-edges false
    default-column-width { proportion 0.7; }
}

window-rule {
    match app-id="code"
    open-focused false
    open-maximized false
    open-fullscreen false
    open-maximized-to-edges false
    default-column-width { proportion 0.7; }
}

window-rule {
    match app-id="kitty"
    open-maximized false
    open-fullscreen false
    open-maximized-to-edges false
}

//PiP
window-rule {
    match title="Picture-in-Picture"
    open-focused false
    open-floating true
    open-maximized false
    open-on-output "HDMI-A-1"
    open-fullscreen false
    //min-width 1300
    max-height 1000 
    default-floating-position x=50 y=50 relative-to="bottom-right"
    opacity 1.0
}

// Zen Browser no DP-3
window-rule {
    match app-id="zen"
    exclude title="Picture-in-Picture"
    open-on-workspace "home"
    open-maximized true
    open-focused true
    open-fullscreen false
    open-maximized-to-edges false
}

window-rule {
    match app-id="obsidian"
    open-on-workspace "home"
    open-focused false
    open-maximized false
    open-fullscreen false
    open-maximized-to-edges false
    default-column-width { proportion 0.7; }
}


// Steam client and Lutris on "games" workspace (side by side)
window-rule {
    match app-id=r"^(steam|net\.lutris\.Lutris)$"
    open-on-workspace "games"
    open-focused false
    open-fullscreen false
    open-maximized false
    open-maximized-to-edges false
    default-column-width { proportion 0.5; }
}

// Gamescope-launched windows on "games" workspace (fullscreen)
window-rule {
    match app-id=r"^gamescope$"
    open-on-workspace "games"
    open-focused true
    open-fullscreen true
}

// Steam game processes on "games" workspace (fullscreen)
window-rule {
    match app-id=r"^steam_app_.*$"
    open-on-workspace "games"
    open-focused true
    open-fullscreen true
}

// Thunar window
// Unity Editor: Hub-launched app IDs include the editor version.
// Keep detached panels/dialogs floating and let Unity choose their sizes.
// Tab docking has a separate xwayland-satellite bug; these rules cannot fix it:
// https://github.com/Supreeeme/xwayland-satellite/issues/286
window-rule {
    match app-id=r#"(?i)^(unity|unityhub-unity-editor-.*)$"#
    open-floating true
    open-fullscreen false
    open-maximized false
    open-maximized-to-edges false
}

// Main project window: tiled, with room for the code IDE alongside it.
window-rule {
    match app-id=r#"(?i)^(unity|unityhub-unity-editor-.*)$"# title="^Unity - "
    open-floating false
    open-focused false
    default-column-width { proportion 0.7; }
}

// Background work should not take keyboard focus from Rider/VS Code.
// Progress titles vary by Unity release; inspect with `niri msg windows`.
// open-focused only controls initial focus, not later activation requests.
window-rule {
    match app-id=r#"(?i)^(unity|unityhub-unity-editor-.*)$"# title=r#"(?i)^(hold on\b|compiling\b|reloading\b|importing\b|refreshing\b)"#
    open-floating true
    open-focused false
}

// Thunar window
window-rule {
    match app-id="Thunar"
    open-floating false
    //default-floating-position x=400 y=500 relative-to="bottom-right"
}

// thunar rename dialog 
window-rule {
    match app-id="Thunar" title="Rename"
    open-floating true
    default-floating-position x=400 y=500 relative-to="bottom-right"
}

