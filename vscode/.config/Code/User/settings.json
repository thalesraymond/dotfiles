{
  "workbench.colorTheme": "Tokyo Night Storm",
  "workbench.iconTheme": "material-icon-theme",
  "editor.fontFamily": "'Droid Sans Mono', 'monospace', monospace,'MesloLGMDZ Nerd Font'",
  "git.enableSmartCommit": true,
  "git.autofetch": true,
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "chat.promptFilesLocations": {
    ".github/prompts": true,
    "/Users/vscode/repos/prompts": true,
    "~/.copilot/prompts": true,
  },
  "python.languageServer": "Pylance",
  "files.autoSave": "afterDelay",
  "git.confirmSync": false,
  "editor.formatOnSave": true,
  "diffEditor.codeLens": true,
  "jestrunner.enableTestExplorer": true,
  "githubPullRequests.pushBranch": "always",
  "svelte.enable-ts-plugin": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "qt-core.additionalQtPaths": [
    {
      "name": "Qt-5.15.18-linux-g++_from_PATH",
      "path": "/usr/bin/qmake",
    },
  ],
  "geminicodeassist.project": "arched-dogfish-9fgnf",
  "http.systemCertificatesNode": true,
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.tabSize": 2,
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "workbench.colorCustomizations": {
    "[Tokyo Night]": {
      "activityBar.foreground": "#ffffffa4",
      "activityBar.inactiveForeground": "#9099abac",
      "activityBar.background": "#16161e",
    },
  },
  "explorer.confirmDragAndDrop": false,
  "geminicodeassist.inlineSuggestions.enableAuto": false,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "go.toolsManagement.autoUpdate": true,
  "chat.sessionSync.enabled": true,
  "githubPullRequests.createOnPublishBranch": "never",
  "chat.tools.terminal.autoApprove": {
    "/^go test \\./\\.\\.\\.$/": {
      "approve": true,
      "matchCommandLine": true,
    },
    "/^openspec status --change \"add-action-logs-and-outputs\" --json$/": {
      "approve": true,
      "matchCommandLine": true,
    },
    "/^hyprctl getoption general:layout -j; echo ---; hyprctl dispatchers \\| grep -iE 'resize\\|layoutmsg'$/": {
      "approve": true,
      "matchCommandLine": true,
    },
    "/^hyprctl binds \\| sed -n '840,1010p'$/": {
      "approve": true,
      "matchCommandLine": true,
    },
  },
  "vscode-pets.theme": "forest",
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
    "*.qrc": "qt-core.qrcEditor",
  },
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://models.dev": true,
    "https://opencode.ai/config.json": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true,
  },
  "explorer.confirmPasteNative": false,
  "chat.viewSessions.orientation": "stacked",
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://opencode.ai": {
      "approveRequest": false,
      "approveResponse": true,
    },
    "https://wiki.hypr.land": true,
  },
  "github.copilot.chat.summarizeAgentConversationHistory.enabled": true,
  "github.copilot.chat.summarizeAgentConversationHistoryThreshold": 0.7,
  "chat.agent.sandbox.enabled": "off",
  "window.newWindowProfile": "Default",
  "workbench.sideBar.location": "right",
  "workbench.activityBar.location": "top",
  "telemetry.telemetryLevel": "error",
}
